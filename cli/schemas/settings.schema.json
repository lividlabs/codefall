{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lividlabs/codefall-cli/main/schemas/settings.schema.json",
  "title": "Codefall settings",
  "description": "Per-repository configuration read from .codefall/settings.json.",
  "type": "object",
  "required": ["version", "tracker", "harnesses"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "tracker": { "type": "string", "enum": ["beads", "github"] },
    "harnesses": {
      "description": "The harnesses the project is set up for, each named for its binary. codefall still reads claude-code and antigravity, the names claude and agy had before, and codefall init rewrites them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["agy", "claude", "codex", "muse", "opencode"]
      }
    },
    "beads": { "type": "object", "properties": {}, "additionalProperties": true },
    "github": {
      "type": "object",
      "required": ["issuesRepo"],
      "properties": {
        "issuesRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "issuesProject": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["postToPullRequest"],
      "properties": {
        "postToPullRequest": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "local": {
      "description": "The project's local-environment commands, each a shell command run from the project root (ADR-005).",
      "type": "object",
      "required": ["start", "update"],
      "properties": {
        "start": { "type": "string", "description": "Brings up what the project needs running locally. Idempotent." },
        "update": { "type": "string", "description": "Makes the local environment match the checkout. Idempotent; may assume start has run." }
      },
      "additionalProperties": true
    },
    "test": {
      "description": "What the project has declared about its test cases: where they live, and which runners are installed (ADR-007).",
      "type": "object",
      "required": ["dir"],
      "properties": {
        "dir": {
          "type": "string",
          "description": "The testing root, relative to the directory holding .codefall/. codefall init asks for it and defaults to testing.",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
        },
        "runners": {
          "type": "array",
          "description": "The spec runners the project has installed, written by codefall-equip rather than by hand.",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["go-test", "playwright"] }
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "properties": { "tracker": { "const": "beads" }, "github": false }, "required": ["tracker", "beads"] },
    { "properties": { "tracker": { "const": "github" }, "beads": false }, "required": ["tracker", "github"] }
  ],
  "additionalProperties": true
}
